<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="100"
    android:viewportHeight="100"
    android:tint="?attr/colorControlNormal">

    <!-- Ring, drawn first so the sphere overlaps its middle -->
    <group
        android:pivotX="50"
        android:pivotY="52"
        android:rotation="-20">
        <path
            android:pathData="M 10,52 A 40,10 0 1 0 90,52 A 40,10 0 1 0 10,52 Z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="6"
            android:fillColor="#00000000" />
    </group>

    <!-- Sphere -->
    <path
        android:pathData="M 28,52 A 22,22 0 1 0 72,52 A 22,22 0 1 0 28,52 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
